# Public site URL used for metadata, canonical, robots and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public WhatsApp number for the floating contact button (digits only, with country code).
# Example: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (server-only). Service role must never be exposed to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Resend (server-only). Internal operator notification after durable persistence.
RESEND_API_KEY=YOUR_RESEND_API_KEY
LEAD_NOTIFICATION_EMAIL=ops@example.com
LEAD_FROM_EMAIL=Atria <onboarding@resend.dev>

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# HMAC secret for lead deduplication and abuse hashes (server-only).
LEAD_HASH_SECRET=replace-with-a-long-random-secret
