# Public site URL used for metadata, canonical, robots and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public WhatsApp number for the floating contact button (digits only, with country code).
# Example: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (server-only). Service role must never be exposed to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Anon key for validating operator JWTs server-side (never use service role in the browser).
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Optional public alias if you already expose the anon key for future Auth UI:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated allow-list of operator emails for /operacao (server-only).
OPERATIONS_OPERATOR_EMAILS=ops@example.com

# Local review only (never in production). When set to 1 in development/test,
# /operacao renders fixture data for screenshots. Mutations stay disabled.
# OPERATIONS_REVIEW_FIXTURES=1

# Resend (server-only). Internal operator notification after durable persistence.
RESEND_API_KEY=YOUR_RESEND_API_KEY
LEAD_NOTIFICATION_EMAIL=ops@example.com
LEAD_FROM_EMAIL=Atria <onboarding@resend.dev>

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# HMAC secret for lead deduplication and abuse hashes (server-only).
LEAD_HASH_SECRET=replace-with-a-long-random-secret

# Crawler / operational data reuse the same server-only Supabase credentials.
# Never expose SUPABASE_SERVICE_ROLE_KEY via NEXT_PUBLIC_* or client bundles.
# Crawl execution is an internal server module (not a public endpoint).
