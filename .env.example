# Public site URL used for metadata, canonical, robots and sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public WhatsApp number for the floating contact button (digits only, with country code).
# Example: 5511999999999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (server-only). Service role must never be exposed to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Resend (server-only). Internal operator notification after durable persistence.
RESEND_API_KEY=YOUR_RESEND_API_KEY
LEAD_NOTIFICATION_EMAIL=ops@example.com
LEAD_FROM_EMAIL=Atria <onboarding@resend.dev>

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=YOUR_TURNSTILE_SECRET_KEY

# HMAC secret for lead deduplication and abuse hashes (server-only).
LEAD_HASH_SECRET=replace-with-a-long-random-secret

# Crawler / operational data reuse the same server-only Supabase credentials.
# Never expose SUPABASE_SERVICE_ROLE_KEY via NEXT_PUBLIC_* or client bundles.
# Crawl execution is an internal server module (not a public endpoint).
# Do not enable production crawling or mass outreach from local env alone.

# Google Places API key (server-only). Used only by the Google Places
# discovery adapter (scripts/crawler/discover-google-places.ts) to call the
# official Places API — never for scraping or browser automation. Omit and
# use --dry-run for a key-free rehearsal against in-memory fixtures.
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
